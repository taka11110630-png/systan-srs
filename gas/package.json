{
  "name": "systan-srs-gas",
  "version": "1.0.0",
  "private": true,
  "description": "Google Apps Script (GAS) CLI workspace using @google/clasp for systan-srs",
  "scripts": {
    "login": "clasp login",
    "login:remote": "clasp login --no-localhost",
    "logout": "clasp logout",
    "whoami": "clasp show-authorized-user",
    "setup": "node scripts/setup.mjs",
    "status": "clasp status",
    "pull": "clasp pull",
    "push": "clasp push",
    "push:force": "clasp push --force",
    "deployments": "clasp deployments",
    "deploy": "clasp deploy",
    "redeploy": "node scripts/redeploy.mjs",
    "versions": "clasp versions",
    "logs": "clasp logs"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1"
  }
}
